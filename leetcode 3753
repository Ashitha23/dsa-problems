from functools import lru_cache

class Solution:
    def totalWaviness(self, num1: int, num2: int) -> int:

        def solve(n: int) -> int:
            if n < 0:
                return 0

            s = str(n)

            @lru_cache(None)
            def dp(pos, prev2, prev1, length, started, tight):
                if pos == len(s):
                    return (1, 0)  # count, waviness sum

                limit = int(s[pos]) if tight else 9

                total_cnt = 0
                total_wav = 0

                for d in range(limit + 1):
                    ntight = tight and (d == limit)

                    if not started and d == 0:
                        cnt, wav = dp(
                            pos + 1,
                            10, 10, 0,
                            False,
                            ntight
                        )
                        total_cnt += cnt
                        total_wav += wav
                        continue

                    if not started:
                        cnt, wav = dp(
                            pos + 1,
                            10, d, 1,
                            True,
                            ntight
                        )
                        total_cnt += cnt
                        total_wav += wav
                        continue

                    add = 0
                    if length >= 2:
                        if ((prev1 > prev2 and prev1 > d) or
                            (prev1 < prev2 and prev1 < d)):
                            add = 1

                    cnt, wav = dp(
                        pos + 1,
                        prev1,
                        d,
                        min(length + 1, 3),
                        True,
                        ntight
                    )

                    total_cnt += cnt
                    total_wav += wav + add * cnt

                return total_cnt, total_wav

            return dp(0, 10, 10, 0, False, True)[1]

        return solve(num2) - solve(num1 - 1)
